package praneeel;
import java.util.Scanner;
public class Seeds 
{
	public static void main(String args[])
	{
		Scanner sc=new Scanner(System.in);
		System.out.print("Please enter a number between 1 and 1000 : ");
		int n=sc.nextInt();
		int num=n;
		int sum=0,digit;
		if(n>0 && n<=1000)
		{
			while(n>0)
			{
				digit=n%10;
				sum+=digit;
				n/=10;
			}
			System.out.println("The sum of digits of "+num+" is : "+sum);
		}
		else
		{
			System.out.println("The entered number does not lie between 0 and 1000");
		}
	}
}
