package praneeel;

public class Employee {

    String employeeName;
    String employeeAddress;
    double employeeSalary;
    String jobRole;

    public Employee(String employeeName, String employeeAddress,
                    double employeeSalary, String jobRole) {

        this.employeeName = employeeName;
        this.employeeAddress = employeeAddress;
        this.employeeSalary = employeeSalary;
        this.jobRole = jobRole;
    }

    public double calculateBonus() {
        return employeeSalary * 0.05;
    }

    public void generatePerformanceReport() {
        System.out.println("Performance Report for : " + employeeName);
        System.out.println("Job Title : " + jobRole);
        System.out.println("Address : " + employeeAddress);
        System.out.println("Salary : " + employeeSalary);
        System.out.println("Bonus : " + calculateBonus());
    }

    public void manageProject() {
        System.out.println(employeeName +
                " is working on general company projects");
    }
}


class Manager extends Employee {

    public Manager(String employeeName, String employeeAddress,
                   double employeeSalary) {

        super(employeeName, employeeAddress, employeeSalary, "Manager");
    }

    public double calculateBonus() {
        return employeeSalary * 0.15;
    }

    public void manageProject() {
        System.out.println(employeeName +
                " is managing multiple company projects and leading the team");
    }
}


class Developer extends Employee {

    public Developer(String employeeName, String employeeAddress,
                     double employeeSalary) {

        super(employeeName, employeeAddress, employeeSalary, "Developer");
    }

    public double calculateBonus() {
        return employeeSalary * 0.15;
    }

    public void manageProject() {
        System.out.println(employeeName +
                " is developing software modules and fixing bugs");
    }
}


class Programmer extends Employee {

    public Programmer(String employeeName, String employeeAddress,
                      double employeeSalary) {

        super(employeeName, employeeAddress, employeeSalary, "Programmer");
    }

    public double calculateBonus() {
        return employeeSalary * 0.15;
    }

    public void manageProject() {
        System.out.println(employeeName +
                " is developing software modules and fixing bugs");
    }
}


class EmployeeHierarchy {

    public static void main(String[] args) {

        Manager manager = new Manager("Alice", "Mumbai", 90000);
        Developer developer = new Developer("Bob", "Pune", 70000);
        Programmer programmer = new Programmer("Tom", "Pune", 60000);

        Employee[] employees = {
            manager, developer, programmer
        };

        for (Employee employee : employees) {

            System.out.println("=========================");

            employee.generatePerformanceReport();
            employee.manageProject();

            System.out.println();
        }
    }
}

